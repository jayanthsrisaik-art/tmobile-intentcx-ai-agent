# Leave empty to run in offline (rule-based) mode
OPENAI_API_KEY=
INTENTCX_MODEL=gpt-4o-mini
# Use the LLM to classify intent when keyword routing confidence is low
INTENTCX_LLM_ROUTING=true
# Force offline mode even if a key is set
INTENTCX_OFFLINE=false
INTENTCX_MAX_TOOL_ROUNDS=5
INTENTCX_MAX_HISTORY=10
